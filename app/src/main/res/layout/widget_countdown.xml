<?xml version="1.0" encoding="utf-8"?>
<!--
    A real android.widget.Chronometer in count-down mode, embedded into the Glance
    widgets via AndroidRemoteViews exactly like widget_clock's TextClock.

    The countdown used to be a Glance Text() built from a formatter at provideGlance()
    time, so it only moved when something re-rendered the widget — at worst a full
    WidgetRefreshWorker period (15 minutes) later, and in Doze not at all. A widget
    rendered at 22:00 for an alarm at 07:00 went on saying "בעוד 9 שע׳" at 06:55.

    A Chronometer ticks inside the host process with no app wake-up at all, so the
    widget is always right to the second. As of v1.10.0 this is used at every
    distance, not only inside the last hour: the hour cutoff assumed a re-render would
    arrive to update the static text above it, and nothing guarantees one.

    Text size/color are set per placement at runtime; the values here are defaults.
-->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:fontFamily="sans-serif-medium"
    android:textSize="10sp"
    android:textColor="#FFFFFFFF" />

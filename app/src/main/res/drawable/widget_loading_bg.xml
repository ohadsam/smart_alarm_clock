<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the rendered widget's own rounded frame so the placeholder doesn't
     flash as a hard-edged rectangle before the real content arrives. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/widget_loading_bg" />
</shape>
